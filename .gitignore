# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# The API build script creates this directory when the frontend has not been built yet.
/frontend/dist/

# Runtime data (SQLite db + encrypted secrets + verification dirs — never commit)
/data/
.verify-*/

# Caches
.cache/
.eslintcache

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment (keep example files tracked)
.env
.env.local
.env.*.local
!.env.example

# Editors / IDE
.vscode/
.idea/
*.sw?

# OS junk
.DS_Store
Thumbs.db

# opcflow workbench (runtime orchestration state; SQLite WAL db)
.workbench/

# Rust build output (cargo workspace, added in later phases)
target/
